---
import levels from '../../../../../data/german-is-easy/levels.json';
import level1 from '../../../../../data/german-is-easy/level1.json';
import level2 from '../../../../../data/german-is-easy/level2.json';
import level3 from '../../../../../data/german-is-easy/level3.json';
import level4 from '../../../../../data/german-is-easy/level4.json';
import level5 from '../../../../../data/german-is-easy/level5.json';
import level6 from '../../../../../data/german-is-easy/level6.json';
import level7 from '../../../../../data/german-is-easy/level7.json';
import level8 from '../../../../../data/german-is-easy/level8.json';
import level9 from '../../../../../data/german-is-easy/level9.json';
import level10 from '../../../../../data/german-is-easy/level10.json';

export function getStaticPaths() {
  return [
    { params: { id: '1' }, props: { levelData: level1 } },
    { params: { id: '2' }, props: { levelData: level2 } },
    { params: { id: '3' }, props: { levelData: level3 } },
    { params: { id: '4' }, props: { levelData: level4 } },
    { params: { id: '5' }, props: { levelData: level5 } },
    { params: { id: '6' }, props: { levelData: level6 } },
    { params: { id: '7' }, props: { levelData: level7 } },
    { params: { id: '8' }, props: { levelData: level8 } },
    { params: { id: '9' }, props: { levelData: level9 } },
    { params: { id: '10' }, props: { levelData: level10 } },
  ];
}

const { levelData } = Astro.props;
const levelMeta = levels.find(l => l.id === levelData.id);

const safeJson = JSON.stringify(levelData)
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e')
  .replace(/&/g, '\\u0026');
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IM+Fell+English:ital@0;1&family=Jost:ital,wght@0,300;0,400;1,400&display=swap" rel="stylesheet" />
  <title>Level {levelData.id} — German Is A̶w̶f̶u̶l̶ Easy</title>
  <script defer src="https://cloud.umami.is/script.js" data-website-id="fa1bd294-88ac-4c65-b29d-8c7656bc9bbc"></script>
</head>
<body>
  <header class="game-header">
    <a href="/languages/german/is-easy/" class="back-link">← Levels</a>
    <div class="header-center">
      <div class="game-name" aria-label="German Is Awful, I mean, Easy">German Is <span class="crayon-strike">Awful<svg class="crayon-line" aria-hidden="true" viewBox="0 0 100 12" preserveAspectRatio="none"></svg></span> Easy</div>
      <div class="level-title">Level {levelData.id}: {levelMeta?.title}</div>
    </div>
    <div class="progress-indicator" id="progress-indicator">
<span id="score-display" class="score-display">0 pts</span>
      <div class="progress-dots" id="progress-dots"></div>
    </div>
  </header>

  <main class="game-main" id="game-main"></main>

  <script type="application/json" id="level-data" set:html={safeJson}></script>
  <script type="application/json" id="level-meta" set:html={JSON.stringify({ requires: levelMeta?.requires ?? null })}></script>

  <script>
    const STORAGE_KEY = 'gie-progress';
    const MODE_KEY    = 'gie-mode';
    const mode        = localStorage.getItem(MODE_KEY) || 'competitive';

    function getProgress() {
      try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); } catch { return {}; }
    }
    function setProgress(p) { localStorage.setItem(STORAGE_KEY, JSON.stringify(p)); }

    const levelData = JSON.parse(document.getElementById('level-data').textContent);
    const levelId = String(levelData.id);
    const totalSubs = levelData.subLevels.length;

    // Preload all images in the level so they're ready when needed
    levelData.subLevels.forEach(s => {
      [s.revealImage, ...( s.hints?.map(h => h.image).filter(Boolean) ?? [])].forEach(url => {
        if (url) new Image().src = url;
      });
    });

    const prog = getProgress();
    const isCasual = mode === 'casual';

    // Redirect to map if this level is locked
    const levelMeta = JSON.parse(document.getElementById('level-meta').textContent);
    const requires = levelMeta.requires;
    if (new URLSearchParams(window.location.search).has('unlock')) {
      localStorage.setItem('gie-unlocked', '1');
    }
    const manualUnlock = !!localStorage.getItem('gie-unlocked');
    if (!manualUnlock && requires != null) {
      const reqEntry = prog[String(requires)];
      const reqDone = reqEntry && (
        reqEntry.done ||
        (reqEntry.comp && reqEntry.comp.done) ||
        (reqEntry.cas  && reqEntry.cas.done)
      );
      if (!reqDone) {
        window.location.replace('/languages/german/is-easy/');
      }
    }

    // Progress is stored in two separate buckets: 'comp' (competitive/challenging) and 'cas' (casual).
    // Old entries without these keys are treated as 'comp' for backward compatibility.
    function getBucket(p) {
      const entry = p[levelId];
      if (!entry) return { current: 0, done: false };
      if ('comp' in entry || 'cas' in entry) return entry[isCasual ? 'cas' : 'comp'] || { current: 0, done: false };
      return isCasual ? { current: 0, done: false } : entry;
    }

    function isAnyDone() {
      const entry = prog[levelId];
      if (!entry) return false;
      if ('comp' in entry || 'cas' in entry) return !!(entry.comp?.done || entry.cas?.done);
      return !!entry.done;
    }

    function anyDoneScore() {
      const entry = prog[levelId];
      if (!entry) return 0;
      if (saved.done) return saved.score || 0;
      if ('comp' in entry || 'cas' in entry) return entry.comp?.score || entry.cas?.score || 0;
      return entry.score || 0;
    }

    function setBucket(p, data) {
      if (!p[levelId]) p[levelId] = {};
      const entry = p[levelId];
      // Migrate old flat format to bucketed format
      if (!('comp' in entry) && !('cas' in entry) && Object.keys(entry).length > 0) {
        p[levelId] = { comp: { ...entry } };
      }
      p[levelId][isCasual ? 'cas' : 'comp'] = data;
    }

    const saved = getBucket(prog);
    let currentIdx = saved.current || 0;

    const gameMain = document.getElementById('game-main');
const progressDots = document.getElementById('progress-dots');
    const scoreDisplay = document.getElementById('score-display');

    if (mode === 'casual') scoreDisplay.style.display = 'none';

    // ── Score ───────────────────────────────────────────────────────────────────
    let score = (!saved.done || saved.current > 0) ? (saved.score || 0) : 0;
    const maxScore = levelData.subLevels.reduce((sum, s) =>
      sum + (s.kind === 'info' ? 0 : s.kind === 'match' ? s.pairs.length * (s.points ?? 5) : (s.points ?? 10)), 0);

    function subLevelPoints(mistakes) {
      if (mistakes === 0) return 10;
      if (mistakes === 1) return 7;
      if (mistakes === 2) return 5;
      return 3;
    }

    function updateScoreDisplay() {
      if (mode !== 'casual') scoreDisplay.textContent = `${score} pts`;
    }

    function popPoints(pts, card, onDone) {
      const ns = 'http://www.w3.org/2000/svg';
      const pop = document.createElement('div');
      pop.className = 'pts-pop';

      // Burst lines SVG
      const svg = document.createElementNS(ns, 'svg');
      svg.setAttribute('class', 'burst-svg');
      svg.setAttribute('viewBox', '-60 -60 120 120');
      svg.setAttribute('aria-hidden', 'true');

      // Radial gradient: opaque at centre, transparent at outer tip
      const defs = document.createElementNS(ns, 'defs');
      const grad = document.createElementNS(ns, 'radialGradient');
      grad.setAttribute('id', 'burst-grad');
      grad.setAttribute('cx', '0'); grad.setAttribute('cy', '0');
      grad.setAttribute('r', '70');
      grad.setAttribute('gradientUnits', 'userSpaceOnUse');
      const s1 = document.createElementNS(ns, 'stop');
      s1.setAttribute('offset', '0.64'); // r=45/70 — fully opaque at line start
      s1.setAttribute('stop-color', '#ff7d00');
      s1.setAttribute('stop-opacity', '1');
      const s2 = document.createElementNS(ns, 'stop');
      s2.setAttribute('offset', '1');
      s2.setAttribute('stop-color', '#ff7d00');
      s2.setAttribute('stop-opacity', '0');
      grad.appendChild(s1); grad.appendChild(s2);
      defs.appendChild(grad);
      svg.appendChild(defs);

      const lineCount = 12;
      for (let i = 0; i < lineCount; i++) {
        const angle = (i / lineCount) * Math.PI * 2;
        const line = document.createElementNS(ns, 'line');
        line.setAttribute('x1', (Math.cos(angle) * 45).toFixed(1));
        line.setAttribute('y1', (Math.sin(angle) * 45).toFixed(1));
        line.setAttribute('x2', (Math.cos(angle) * 70).toFixed(1));
        line.setAttribute('y2', (Math.sin(angle) * 70).toFixed(1));
        line.setAttribute('class', 'burst-line');
        svg.appendChild(line);
      }

      const textEl = document.createElement('div');
      textEl.className = 'pts-text';
      textEl.textContent = `+${pts}`;

      pop.appendChild(svg);
      pop.appendChild(textEl);
      card.appendChild(pop);
      pop.addEventListener('animationend', (e) => {
        if (e.target === pop) { pop.remove(); onDone(); }
      });
    }

    // ── Progress UI ────────────────────────────────────────────────────────────
    function renderProgressDots() {
progressDots.innerHTML = '';
      for (let i = 0; i < totalSubs; i++) {
        const dot = document.createElement('span');
        dot.className = 'dot' + (i < currentIdx ? ' done' : i === currentIdx ? ' active' : '');
        progressDots.appendChild(dot);
      }
    }

    // ── Navigation ─────────────────────────────────────────────────────────────
    function advanceSubLevel() {
      currentIdx++;
      const p = getProgress();
      if (currentIdx >= totalSubs) {
        setBucket(p, isCasual
          ? { current: 0, done: true }
          : { current: 0, done: true, score, maxScore });
        setProgress(p);
        if (typeof umami !== 'undefined') umami.track(`GIE Level ${levelData.id} complete`);
        showLevelComplete();
      } else {
        const alreadyDone = getBucket(p).done;
        setBucket(p, isCasual
          ? { current: currentIdx, done: alreadyDone || false }
          : { current: currentIdx, done: alreadyDone || false, score, maxScore });
        setProgress(p);
        renderSubLevel(currentIdx);
      }
    }

    // ── Memory helpers ─────────────────────────────────────────────────────────
    function targetToEnglish(target) {
      let out = '';
      let suppressNextSpace = false;
      for (const item of target) {
        const noSpaceBefore = suppressNextSpace || item.word === ',' || item.word === '.' || item.word === '!' || item.word === '?' || item.word === '\u201D' || item.word === ')' || item.word === '\u2019';
        if (out && !noSpaceBefore) out += ' ';
        out += item.word;
        suppressNextSpace = item.spaceAfter === false;
      }
      return out.trim();
    }

    function reconstructWordOrder(sub) {
      const clauses = sub.clauses || [{ elements: sub.elements, target: sub.target, prefix: sub.prefix, separator: sub.separator }];
      return clauses.map((clause, ci) => {
        const prefixWords = clause.prefix
          ? (Array.isArray(clause.prefix) ? clause.prefix : [clause.prefix]).map(p => p.text)
          : [];
        const s1   = clause.elements.find(e => e.id === clause.target.slot1);
        const s2   = clause.elements.find(e => e.id === clause.target.slot2);
        const rest = clause.elements.filter(e => e.id !== clause.target.slot1 && e.id !== clause.target.slot2);
        const parts = [...prefixWords];
        if (s1) {
          let t = s1.text;
          if (ci === 0 && prefixWords.length === 0) t = t.charAt(0).toUpperCase() + t.slice(1);
          parts.push(t);
        }
        if (s2) parts.push(s2.text);
        rest.forEach(e => parts.push(e.text));
        const sepElem = [s1, s2, ...rest].find(e => e?.separablePrefix);
        if (sepElem) parts.push(sepElem.separablePrefix);
        return parts.join(' ') + (clause.separator || '');
      }).join(' ');
    }

    function subToSummary(sub) {
      switch (sub.kind) {
        case 'translate':
          return { de: sub.german, en: targetToEnglish(sub.target) };
        case 'produce':
          return { de: targetToEnglish(sub.target), en: sub.english || sub.german };
        case 'choice': {
          const correct = sub.choices.find(c => c.correct);
          return { de: sub.german, en: correct ? correct.label : '—' };
        }
        case 'reorder':
        case 'compass': {
          const ordered = sub.slots.map(s => `${s.label} – ${s.answer}`).join(', ');
          return { de: ordered, en: null };
        }
        case 'categorize': {
          const lines = sub.groups.map(g => `${g.label}: ${g.answers.join(', ')}`).join('\n');
          return { de: sub.german, en: lines };
        }
        case 'match':
          return { de: 'Word pairs', en: sub.pairs.map(p => `${p.german} – ${p.english}`).join('\n') };
        case 'wordorder':
          return { de: reconstructWordOrder(sub), en: sub.english || null };
        case 'arrange':
          return { de: sub.answer.join(' '), en: sub.english || null };
        case 'buildaword':
          return { de: sub.words.map(w => w.parts.map(p => p.blank || p.text).join('')).join(' / '), en: null };
        default:
          return { de: sub.german || '', en: null };
      }
    }

    function buildMemoryContent(upToIdx) {
      const frag = document.createDocumentFragment();
      for (let i = 0; i < upToIdx; i++) {
        const sub = levelData.subLevels[i];
        if (sub.kind === 'info') continue;

        if (sub.kind === 'match' && sub.useGroupingsToDisplay) {
          // Build grouped display: collect groups in order of first appearance
          const groupOrder = [];
          const groupMap = new Map();
          for (const pair of sub.pairs) {
            const groups = pair.groupings && pair.groupings.length > 0 ? pair.groupings : ['Other'];
            for (const g of groups) {
              if (!groupMap.has(g)) { groupMap.set(g, []); groupOrder.push(g); }
              groupMap.get(g).push(pair);
            }
          }
          for (const label of groupOrder) {
            const header = document.createElement('div');
            header.className = 'memory-group-header';
            header.textContent = label;
            frag.appendChild(header);
            for (const pair of groupMap.get(label)) {
              const entry = document.createElement('div');
              entry.className = 'memory-entry memory-entry-compact';
              const deSpan = document.createElement('span');
              deSpan.className = 'memory-de';
              deSpan.textContent = pair.german;
              const enSpan = document.createElement('span');
              enSpan.className = 'memory-en';
              enSpan.style.fontFamily = "'Jost', sans-serif";
              enSpan.textContent = pair.english;
              entry.appendChild(deSpan);
              entry.append(' ~ ');
              entry.appendChild(enSpan);
              frag.appendChild(entry);
            }
          }
        } else if (sub.kind === 'wordorder') {
          const entry = document.createElement('div');
          entry.className = 'memory-entry';
          if (sub.german) {
            const promptEl = document.createElement('div');
            promptEl.className = 'memory-de';
            promptEl.textContent = sub.german;
            entry.appendChild(promptEl);
          } else if (sub.english) {
            const promptEl = document.createElement('div');
            promptEl.className = 'memory-en';
            promptEl.textContent = sub.english;
            entry.appendChild(promptEl);
          }
          const answerEl = document.createElement('div');
          answerEl.className = 'memory-de';
          answerEl.textContent = reconstructWordOrder(sub);
          entry.appendChild(answerEl);
          frag.appendChild(entry);
        } else if (sub.kind === 'buildaword') {
          const group = document.createElement('div');
          group.className = 'memory-baw-group';
          for (const word of sub.words) {
            const entry = document.createElement('div');
            entry.className = 'memory-entry-compact';
            let german = '';
            for (const part of word.parts) {
              if (part.sep) {
                if (german && !german.endsWith(' ')) german += ' ';
                german += part.text.trim() + ' ';
              } else {
                german += part.blank ?? part.text ?? '';
              }
            }
            const enSpan = document.createElement('span');
            enSpan.className = 'memory-en';
            enSpan.textContent = word.definition;
            const deSpan = document.createElement('span');
            deSpan.className = 'memory-de';
            deSpan.textContent = german.trim();
            entry.appendChild(enSpan);
            entry.append(' – ');
            entry.appendChild(deSpan);
            group.appendChild(entry);
          }
          frag.appendChild(group);
        } else {
          const { de, en } = subToSummary(sub);
          const entry = document.createElement('div');
          entry.className = 'memory-entry';
          const deEl = document.createElement('div');
          deEl.className = 'memory-de';
          deEl.textContent = de;
          entry.appendChild(deEl);
          if (en) {
            const enEl = document.createElement('div');
            enEl.className = 'memory-en';
            enEl.textContent = en;
            entry.appendChild(enEl);
          }
          frag.appendChild(entry);
        }
      }
      return frag;
    }

    function showMemoryModal(upToIdx) {
      const backdrop = document.createElement('div');
      backdrop.className = 'memory-backdrop';
      const modal = document.createElement('div');
      modal.className = 'memory-modal';
      const header = document.createElement('div');
      header.className = 'memory-header';
      header.appendChild(Object.assign(document.createElement('h3'), { textContent: 'Memory' }));
      const closeBtn = document.createElement('button');
      closeBtn.className = 'memory-close';
      closeBtn.textContent = '×';
      closeBtn.setAttribute('aria-label', 'Close');
      header.appendChild(closeBtn);
      modal.appendChild(header);
      const body = document.createElement('div');
      body.className = 'memory-body';
      body.appendChild(buildMemoryContent(upToIdx));
      modal.appendChild(body);
      backdrop.appendChild(modal);
      document.body.appendChild(backdrop);
      const close = () => {
        backdrop.remove();
        const next = document.querySelector('.task-area input:not(:disabled)');
        if (next) next.focus();
      };
      closeBtn.addEventListener('click', close);
      backdrop.addEventListener('click', e => { if (e.target === backdrop) close(); });
    }

    function launchConfetti() {
      const colors = ['#15616d', '#ff7d00', '#2d7a3a', '#b91c1c', '#f59e0b', '#6366f1'];
      const pieces = 80;
      const container = document.createElement('div');
      container.style.cssText = 'position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:999';
      document.body.appendChild(container);
      for (let i = 0; i < pieces; i++) {
        const piece = document.createElement('div');
        const size = 6 + Math.random() * 6;
        const x = Math.random() * 100;
        const delay = Math.random() * 0.6;
        const duration = 1.8 + Math.random() * 1.2;
        const rotate = Math.random() * 720 - 360;
        const drift = (Math.random() - 0.5) * 120;
        piece.style.cssText = `
          position:absolute;
          left:${x}%;top:-10px;
          width:${size}px;height:${size * (0.5 + Math.random())}px;
          background:${colors[Math.floor(Math.random() * colors.length)]};
          border-radius:${Math.random() > 0.5 ? '50%' : '1px'};
          animation:confetti-fall ${duration}s ${delay}s ease-in forwards;
          --drift:${drift}px;--rotate:${rotate}deg;
        `;
        container.appendChild(piece);
      }
      setTimeout(() => container.remove(), 3500);
    }

    function showLevelComplete(autoOpenReview = false) {
      renderProgressDots();
      gameMain.innerHTML = '';
      if (!autoOpenReview) launchConfetti();
      const card = el('div', 'complete-card');
      card.appendChild(elText('div', 'complete-icon', '✓'));
      card.appendChild(elText('h2', '', 'Level complete!'));
      if (mode !== 'casual') {
        card.appendChild(elText('p', 'complete-score', `${score} / ${maxScore} pts`));
      }
      const reviewSection = el('div', 'complete-review');
      const reviewToggle = el('button', 'review-toggle');
      const reviewBody = el('div', 'review-body');
      reviewBody.appendChild(buildMemoryContent(totalSubs));
      if (autoOpenReview) {
        reviewBody.style.display = '';
        reviewToggle.textContent = 'Hide review ▴';
      } else {
        reviewBody.style.display = 'none';
        reviewToggle.textContent = 'Review ▾';
      }
      reviewToggle.addEventListener('click', () => {
        const open = reviewBody.style.display !== 'none';
        reviewBody.style.display = open ? 'none' : '';
        reviewToggle.textContent = open ? 'Review ▾' : 'Hide review ▴';
      });
      reviewSection.appendChild(reviewToggle);
      reviewSection.appendChild(reviewBody);
      card.appendChild(reviewSection);

      const btn = el('a', 'next-btn');
      btn.href = '/languages/german/is-easy/';
      btn.textContent = '← Back to levels';
      card.appendChild(btn);
      gameMain.appendChild(card);
      setTimeout(() => {
        if (!autoOpenReview) btn.focus();
        document.addEventListener('keydown', function onKey(e) {
          if (e.key === 'Enter') {
            document.removeEventListener('keydown', onKey);
            window.location.href = '/languages/german/is-easy/';
          }
        });
      }, 500);
    }

    // ── Sub-level renderer ─────────────────────────────────────────────────────
    function renderSubLevel(idx) {
      renderProgressDots();
      gameMain.innerHTML = '';

      const sub = levelData.subLevels[idx];

      // ── Info screen ────────────────────────────────────────────────────────────
      if (sub.kind === 'info') {
        const card = el('div', 'sub-level-card');
        for (const p of (sub.paragraphs || [])) {
          const text = typeof p === 'string' ? p : (p[mode] ?? p['default'] ?? '');
          if (text) {
            const pEl = el('p', 'info-paragraph');
            pEl.innerHTML = text;
            card.appendChild(pEl);
          }
        }
        const btn = elText('button', 'next-btn', sub.buttonText || 'Continue →');
        const onEnterInfo = (e) => {
          if (e.key === 'Enter') { document.removeEventListener('keydown', onEnterInfo); advanceSubLevel(); }
        };
        btn.addEventListener('click', () => { document.removeEventListener('keydown', onEnterInfo); advanceSubLevel(); });
        document.addEventListener('keydown', onEnterInfo);
        card.appendChild(btn);
        gameMain.appendChild(card);
        setTimeout(() => btn.focus(), 50);
        return;
      }

      const card = el('div', 'sub-level-card');

      // Sentence display: german first, then english
      if (sub.german) {
        card.appendChild(elText('div', 'german-text', sub.german));
      }
      if (sub.english && sub.showEnglishAtStart !== false) {
        card.appendChild(elText('div', 'english-text', sub.english));
      }
      if (sub.attribution) {
        const attrEl = el('div', 'attribution');
        attrEl.innerHTML = `— ${sub.attribution}`;
        card.appendChild(attrEl);
      }

      // Instruction
      const instructionText =
        sub.instruction ||
        (sub.kind === 'translate'  ? 'Translate' :
         sub.kind === 'produce'   ? 'Answer in German' :
         sub.kind === 'choice'     ? 'Choose the correct answer' :
         sub.kind === 'reorder'    ? 'Put in the correct order' :
         sub.kind === 'compass'    ? 'Match the positions' :
         sub.kind === 'categorize' ? 'Sort into the correct group' :
         sub.kind === 'match'      ? 'Matching game' :
         sub.kind === 'wordorder'  ? 'Move words into the slots (−1 pt per invalid move)' :
         sub.kind === 'arrange'    ? 'Build the German sentence' :
         sub.kind === 'buildaword' ? 'Build the German words (−1 pt per incorrect placement)' : '');
      const maxPts = sub.points ?? 10;
      let potentialPointsEl = null;
      if (instructionText) {
        const instrRow = el('div', sub.kind === 'match' ? 'instruction-row instruction-row-match' : 'instruction-row');
        instrRow.appendChild(elText('span', 'instruction', instructionText));
        if (mode !== 'casual' && sub.kind !== 'match') {
          potentialPointsEl = elText('span', 'potential-points', `(${maxPts} pts)`);
          instrRow.appendChild(potentialPointsEl);
        }
        card.appendChild(instrRow);
      }

      // Task area
      const taskArea = el('div', 'task-area');

      // Next button (shared)
      const nextBtn = el('button', 'next-btn');
      const isLast = idx < totalSubs - 1;
      nextBtn.textContent = isLast ? 'Next ⏎' : 'Finish ⏎';
      nextBtn.title = isLast ? 'Next puzzle (press Enter)' : 'Finish level (press Enter)';
      // Use style.display rather than the hidden attribute — some browsers' UA
      // stylesheet lacks !important on [hidden], so author CSS can override it.
      nextBtn.style.display = 'none';

      let hintDeduction = 0;
      let taskFailed = false;
      let mistakeCount = 0;
      // choice: all-or-nothing; reorder/categorize: −1 pt per wrong placement; translate: no penalty
      const onMistake = sub.kind === 'choice'                                              ? () => { taskFailed = true; }
                      : (sub.kind === 'reorder' || sub.kind === 'compass' || sub.kind === 'categorize' || sub.kind === 'wordorder' || sub.kind === 'arrange' || sub.kind === 'buildaword') ? () => { mistakeCount++; }
                      : () => {};

      const refreshPotentialPoints = () => {
        if (!potentialPointsEl) return;
        const pts = taskFailed ? 0 : Math.max(0, maxPts - hintDeduction - mistakeCount);
        potentialPointsEl.textContent = `(${pts} ${pts === 1 ? 'pt' : 'pts'})`;
      };
      const onMistakeTracked = () => { onMistake(); refreshPotentialPoints(); refreshSkipLabel(); };

      // focusNextInput is set after the task is rendered (translate only)
      let focusNextInput = null;
      let puzzleSolve = null;
      let refreshHintBtn = () => {};
      let refreshSkipLabel = () => {};

      // Hints area (visible before completion)
      const hints = sub.hints || [];
      const hintsArea = el('div', 'hints-area');
      const btnRow = el('div', 'hints-btn-row');
      hintsArea.appendChild(btnRow);
      if (hints.length > 0 && mode !== 'challenging') {
        const revealedHints = el('div', 'revealed-hints');
        hintsArea.insertBefore(revealedHints, btnRow);
        let hintIdx = 0;
        const hintBtn = el('button', 'hint-btn');
        const isHintRedundant = (h) => {
          if (!h.hintFor || !h.hintFor.length) return false;
          return h.hintFor.every(word => {
            const inp = taskArea.querySelector(`.word-input[data-answer="${CSS.escape(word)}"]`);
            if (inp) return inp.classList.contains('correct');
            const slot = taskArea.querySelector(`.baw-slot[data-answer="${CSS.escape(word.toLowerCase())}"]`);
            return slot && slot.classList.contains('baw-slot-correct');
          });
        };
        refreshHintBtn = () => {
          while (hintIdx < hints.length && isHintRedundant(hints[hintIdx])) hintIdx++;
          if (hintIdx < hints.length) {
            const cost = hints[hintIdx].points ?? 3;
            const costStr = mode === 'casual' ? 'free' : (cost === 0 ? 'free' : `−${cost} ${cost === 1 ? 'pt' : 'pts'}`);
            hintBtn.innerHTML = `Hint <span class="btn-pts">(${costStr})</span>`;
          } else {
            hintBtn.style.display = 'none';
          }
        };
        refreshHintBtn();
        hintBtn.addEventListener('click', () => {
          while (hintIdx < hints.length && isHintRedundant(hints[hintIdx])) hintIdx++;
          if (hintIdx >= hints.length) { hintBtn.style.display = 'none'; return; }
          const h = hints[hintIdx];
          if (mode !== 'casual') hintDeduction += h.points ?? 3;
          refreshPotentialPoints();
          const hintEl = document.createElement('div');
          hintEl.className = 'hint-text';
          if (h.image) {
            const img = document.createElement('img');
            img.src = h.image;
            img.alt = h.alt || h.hint || 'Hint';
            img.className = 'hint-img';
            hintEl.appendChild(img);
            if (h.hint) {
              const span = document.createElement('span');
              span.innerHTML = h.hint;
              hintEl.appendChild(span);
            }
          } else {
            const label = document.createElement('strong');
            label.textContent = 'Hint: ';
            hintEl.appendChild(label);
            const span = document.createElement('span');
            span.innerHTML = h.hint;
            hintEl.appendChild(span);
          }
          revealedHints.appendChild(hintEl);
          hintIdx++;
          refreshHintBtn();
          if (focusNextInput) focusNextInput();
        });
        btnRow.appendChild(hintBtn);
      }
      if (['wordorder', 'reorder', 'compass', 'categorize', 'arrange', 'buildaword'].includes(sub.kind)) {
        const skipBtn = el('button', 'reveal-letter-btn');
        const getSkipPts = () => Math.max(0, maxPts - hintDeduction - mistakeCount);
        const skipNormalHTML = () => { const p = getSkipPts(); return mode === 'casual' ? 'Skip' : `Skip <span class="btn-pts">(−${p} ${p === 1 ? 'pt' : 'pts'})</span>`; };
        const skipConfirmHTML = 'Confirm skip';
        skipBtn.innerHTML = skipNormalHTML();
        if (sub.kind === 'arrange' || sub.kind === 'buildaword') refreshSkipLabel = () => { skipBtn.innerHTML = skipNormalHTML(); };
        let skipPrimed = false;
        skipBtn.addEventListener('click', () => {
          if (!skipPrimed) {
            skipPrimed = true;
            skipBtn.innerHTML = skipConfirmHTML;
          } else {
            hintDeduction += getSkipPts();
            refreshPotentialPoints();
            if (puzzleSolve) puzzleSolve();
          }
        });
        document.addEventListener('click', (e) => {
          if (skipPrimed && e.target !== skipBtn) {
            skipPrimed = false;
            skipBtn.innerHTML = skipNormalHTML();
          }
        }, { capture: true });
        btnRow.appendChild(skipBtn);
      }
      if (sub.kind === 'translate' || sub.kind === 'produce') {
        const revealBtn = el('button', 'reveal-letter-btn');
        revealBtn.innerHTML = mode === 'casual' ? 'Reveal letter' : 'Reveal letter <span class="btn-pts">(−3 pts)</span>';
        revealBtn.addEventListener('click', () => {
          const input = taskArea.querySelector('input:not(:disabled)');
          if (!input || !input._acceptedWords) return;
          const accepted = input._acceptedWords;
          const current = input.value;
          // Pick accepted word with longest matching prefix; tie-break: array order
          let bestWord = accepted[0];
          let bestPrefixLen = 0;
          for (const w of accepted) {
            let len = 0;
            while (len < current.length && len < w.length &&
                   current[len].toLowerCase() === w[len].toLowerCase()) {
              len++;
            }
            if (len > bestPrefixLen) { bestPrefixLen = len; bestWord = w; }
          }
          const newValue = bestWord.slice(0, bestPrefixLen + 1);
          if (newValue.toLowerCase() === current.toLowerCase()) return;
          input.value = newValue;
          if (mode !== 'casual') {
            hintDeduction += 3;
            updateScoreDisplay();
            refreshPotentialPoints();
          }
          input.dispatchEvent(new Event('input'));
          if (focusNextInput) focusNextInput();
        });
        btnRow.appendChild(revealBtn);
      }
      if (idx > 0) {
        const memBtn = el('button', 'memory-btn');
        memBtn.textContent = 'Memory';
        memBtn.addEventListener('click', () => showMemoryModal(idx));
        btnRow.appendChild(memBtn);
      }
      // Reveal area (hidden until completion)
      const revealArea = el('div', 'reveal-area');
      revealArea.style.display = 'none';
      if (sub.reveal) {
        sub.reveal.split(/\n\n+/).forEach(para => {
          const revealP = el('p', 'reveal-text');
          revealP.innerHTML = para;
          wrapEmojis(revealP);
          revealArea.appendChild(revealP);
        });
      }
      if (sub.revealImage) {
        const img = document.createElement('img');
        img.src = sub.revealImage;
        img.alt = sub.revealImageAlt || '';
        img.className = 'hint-img reveal-img';
        revealArea.appendChild(img);
      }

      const showNext = () => {
        hintsArea.style.display = 'none';
        if (sub.kind === 'categorize' || sub.kind === 'reorder' || sub.kind === 'compass' || sub.kind === 'arrange') {
          taskArea.querySelector('.word-bank')?.remove();
        }
        if (sub.reveal || sub.revealImage) revealArea.style.display = '';
        const pts = taskFailed ? 0 : Math.max(0, maxPts - hintDeduction - mistakeCount);
        score += pts;
        if (mode !== 'casual') {
          updateScoreDisplay();
          scoreDisplay.classList.add('score-bump');
          scoreDisplay.addEventListener('animationend', () => scoreDisplay.classList.remove('score-bump'), { once: true });
          popPoints(pts, card, () => {
            nextBtn.style.display = '';
            nextBtn.focus({ preventScroll: true });
          });
        } else {
          nextBtn.style.display = '';
          nextBtn.focus({ preventScroll: true });
        }
      };

      switch (sub.kind) {
        case 'translate':
        case 'produce':    focusNextInput = renderTranslate(sub, taskArea, showNext, onMistakeTracked, refreshHintBtn); break;
        case 'choice':     renderChoice(sub, taskArea, showNext, onMistakeTracked);     break;
        case 'reorder':    puzzleSolve = renderReorder(sub, taskArea, showNext, onMistakeTracked);    break;
        case 'compass':    puzzleSolve = renderCompass(sub, taskArea, showNext, onMistakeTracked);    break;
        case 'arrange':    puzzleSolve = renderArrange(sub, taskArea, showNext, onMistakeTracked, () => Math.max(0, maxPts - hintDeduction - mistakeCount), refreshSkipLabel);    break;
        case 'categorize': puzzleSolve = renderCategorize(sub, taskArea, showNext, onMistakeTracked); break;
        case 'wordorder':  puzzleSolve = renderWordOrder(sub, taskArea, showNext, onMistakeTracked);  break;
        case 'buildaword': puzzleSolve = renderBuildAWord(sub, taskArea, showNext, onMistakeTracked, refreshHintBtn); break;
        case 'match':
          renderMatch(sub, taskArea,
            (pts) => { score += pts; if (mode !== 'casual') updateScoreDisplay(); },
            () => {
              taskArea.style.display = 'none';
              if (sub.reveal || sub.revealImage) revealArea.style.display = '';
              nextBtn.style.display = '';
              nextBtn.focus({ preventScroll: true });
            }
          );
          break;
      }

      card.appendChild(taskArea);
      if (sub.kind === 'buildaword') card.classList.add('buildaword-card');
      if (sub.explanation) {
        const explanationEl = el('div', 'explanation-text');
        explanationEl.innerHTML = sub.explanation;
        card.appendChild(explanationEl);
      }
      if (sub.kind !== 'match') card.appendChild(hintsArea);
      card.appendChild(revealArea);
      card.appendChild(nextBtn);
      gameMain.appendChild(card);

      // Desktop: focus the first input right away (physical keyboard, nothing obscured).
      // Touch devices: don't auto-focus — the on-screen keyboard would cover the
      // sentence. Instead, a tap anywhere non-interactive on the card focuses the
      // first empty input. The focus() must run synchronously inside the tap
      // gesture, or iOS won't bring up the keyboard.
      if (focusNextInput && !window.matchMedia('(pointer: coarse)').matches) {
        focusNextInput();
      }
      card.addEventListener('click', (e) => {
        if (!focusNextInput) return;
        if (e.target.closest('button, a, input')) return;
        if (window.getSelection()?.toString()) return;
        focusNextInput();
      });

      // Always remove the keydown listener before advancing, whether via click or Enter,
      // so listeners don't accumulate across sub-levels.
      const onKeyDown = (e) => {
        if (e.key === 'Enter' && nextBtn.style.display !== 'none' && !(document.activeElement instanceof HTMLInputElement)) {
          document.removeEventListener('keydown', onKeyDown);
          advanceSubLevel();
        }
      };
      nextBtn.addEventListener('click', () => {
        document.removeEventListener('keydown', onKeyDown);
        advanceSubLevel();
      });
      document.addEventListener('keydown', onKeyDown);
    }

    // ── Translate task ─────────────────────────────────────────────────────────
    function renderTranslate(sub, container, onComplete, onMistake, onWordAccepted = () => {}) {
      const answerRow = el('div', 'answer-row');
      const inputs = [];

      // preChoice: the first non-given target word is shown as a given (the button choice covers it)
      const preChoiceIdx = sub.preChoice ? sub.target.findIndex(item => !item.given) : -1;

      let currentGroup = null;
      for (let ti = 0; ti < sub.target.length; ti++) {
        const item = sub.target[ti];
        const renderAsGiven = (ti === preChoiceIdx) || (item.given && !(mode === 'challenging' && item.challengingInput));
        let domEl;
        if (renderAsGiven) {
          domEl = elText('span', 'given-word', item.word);
        } else {
          const input = document.createElement('input');
          input.type = 'text';
          input.className = 'word-input';
          const acceptedWords = [item.word, ...(Array.isArray(item.also) ? item.also : item.also ? [item.also] : [])];
          input._acceptedWords = acceptedWords;
          input.dataset.answer = item.word;
          const chWidth = w => {
            const wides = (w.match(/[A-Zwm]/g) || []).length;
            return wides * 1.4 + (w.length - wides) * 0.85 + 2;
          };
          input.style.width = Math.max(5, ...acceptedWords.map(chWidth)) + 'ch';
          input.autocomplete = 'off';
          input.spellcheck = false;
          input.setAttribute('autocorrect', 'off');
          input.setAttribute('autocapitalize', 'off');

          const accept = (matched) => {
            input.value = matched; // preserve which accepted form was typed
            input.classList.remove('wrong');
            input.classList.add('correct');
            input.disabled = true;
            onWordAccepted();
            if (inputs.every(i => i.disabled)) {
              onComplete();
            } else {
              const idx = inputs.indexOf(input);
              const next = inputs.slice(idx + 1).find(i => !i.disabled)
                        || inputs.find(i => !i.disabled);
              if (next) next.focus();
            }
          };

          const rejectExplicit = () => {
            if (input.disabled) return;
            const val = input.value.trim();
            if (!val) return;
            const match = acceptedWords.find(w => w.toLowerCase() === val.toLowerCase());
            if (match) { accept(match); return; }
            onMistake();
            input.classList.add('wrong');
            input.value = '';
            setTimeout(() => { input.classList.remove('wrong'); input.focus(); }, 500);
          };

          // Accept as soon as the typed value matches any accepted word
          input.addEventListener('input', () => {
            if (input.disabled) return;
            // Strip non-letters — mobile keyboards bypass keydown so the key handler doesn't fire
            const val = input.value;
            const cleaned = val.replace(/[^\p{L}]/gu, '');
            if (cleaned !== val) {
              const sel = input.selectionStart;
              const removedBefore = (val.slice(0, sel).match(/[^\p{L}]/gu) || []).length;
              input.value = cleaned;
              input.setSelectionRange(sel - removedBefore, sel - removedBefore);
            }
            const typed = input.value.trim().toLowerCase();
            const match = acceptedWords.find(w => w.toLowerCase() === typed);
            if (match) accept(match);
          });

          // Enter/Tab: explicit submit — reject with feedback if wrong
          input.addEventListener('keydown', (e) => {
            if (e.key.length === 1 && !/^\p{L}$/u.test(e.key)) { e.preventDefault(); return; }
            if (e.key === 'Enter' || e.key === 'Tab') {
              e.preventDefault();
              if (!input.disabled) rejectExplicit();
            }
          });

          inputs.push(input);
          domEl = input;
        }

        if (item.spaceAfter === false) {
          if (!currentGroup) {
            currentGroup = el('span', 'tight-group');
            answerRow.appendChild(currentGroup);
          }
          currentGroup.appendChild(domEl);
        } else {
          if (currentGroup) {
            currentGroup.appendChild(domEl);
            currentGroup = null;
          } else {
            answerRow.appendChild(domEl);
          }
        }
      }

      container.appendChild(answerRow);

      if (sub.preChoice) {
        answerRow.style.display = 'none';
        const choiceRow = el('div', 'choice-row');
        for (const label of sub.preChoice.choices) {
          const btn = elText('button', 'choice-btn', label);
          btn.addEventListener('click', () => {
            if (label === sub.preChoice.correct) {
              choiceRow.style.display = 'none';
              answerRow.style.display = '';
              const first = inputs.find(i => !i.disabled);
              if (first) first.focus();
            } else {
              onMistake();
              choiceRow.querySelectorAll('.choice-btn').forEach(b => b.disabled = true);
              btn.classList.add('wrong');
              setTimeout(() => {
                choiceRow.querySelectorAll('.choice-btn').forEach(b => {
                  b.disabled = false;
                  b.classList.remove('wrong');
                });
              }, 600);
            }
          });
          choiceRow.appendChild(btn);
        }
        container.insertBefore(choiceRow, answerRow);
      }

      // Initial focus happens in renderSubLevel after the card is attached,
      // synchronously within the tap gesture so iOS brings up the keyboard.

      // Return a function the caller can use to refocus the next empty input
      return () => { const next = inputs.find(i => !i.disabled); if (next) next.focus(); };
    }

    // ── Choice task ────────────────────────────────────────────────────────────
    function renderChoice(sub, container, onComplete, onMistake) {
      const row = el('div', 'choice-row');

      for (const choice of sub.choices) {
        const btn = elText('button', 'choice-btn', choice.label);
        btn.addEventListener('click', () => {
          // Disable all buttons
          row.querySelectorAll('.choice-btn').forEach(b => b.disabled = true);

          if (choice.correct) {
            btn.classList.add('correct');
            setTimeout(onComplete, 400);
          } else {
            onMistake();
            btn.classList.add('wrong');
            // Re-enable other buttons after flash
            setTimeout(() => {
              row.querySelectorAll('.choice-btn:not(.correct)').forEach(b => {
                b.disabled = false;
                b.classList.remove('wrong');
              });
            }, 600);
          }
        });
        row.appendChild(btn);
      }

      container.appendChild(row);
    }

    // ── Reorder task ───────────────────────────────────────────────────────────
    function renderReorder(sub, container, onComplete, onMistake) {
      // Shuffle the word bank
      const shuffled = shuffle(sub.slots.map(s => s.answer));

      // Slots grid
      const slotsEl = el('div', 'reorder-slots');
      const labelEls = [];
      const slotEls = sub.slots.map(slot => {
        const row = el('div', 'slot-row');
        const label = elText('span', 'slot-label', slot.label);
        if (/^\p{Extended_Pictographic}[️⃣]?$/u.test(slot.label.trim())) label.classList.add('slot-label-emoji');
        const drop = el('div', 'slot-drop');
        drop.dataset.answer = slot.answer;
        row.appendChild(label);
        row.appendChild(drop);
        slotsEl.appendChild(row);
        labelEls.push(label);
        return drop;
      });

      // Word bank
      const bankEl = el('div', 'word-bank');
      const wordEls = shuffled.map(word => {
        const w = elText('button', 'bank-word', word);
        bankEl.appendChild(w);
        return w;
      });

      container.appendChild(slotsEl);
      container.appendChild(bankEl);

      requestAnimationFrame(() => {
        const maxLabelW = Math.max(...labelEls.map(l => l.offsetWidth));
        labelEls.forEach(l => { l.style.width = maxLabelW + 'px'; });
        const maxW = Math.max(...wordEls.map(w => w.offsetWidth));
        slotEls.forEach(s => { s.style.minWidth = maxW + 'px'; });
      });

      let selected = null; // currently selected word button (click mode)
      let dragWord = null; // word element being dragged (drag mode)

      function selectWord(wordEl) {
        if (selected) selected.classList.remove('selected');
        selected = wordEl;
        selected.classList.add('selected');
      }

      function returnToBank(slotEl) {
        const prevWord = slotEl.dataset.placed;
        const prevEl = wordEls.find(w => w.textContent === prevWord && w.style.display === 'none');
        if (prevEl) prevEl.style.display = '';
        delete slotEl.dataset.placed;
        slotEl.textContent = '';
        slotEl.classList.remove('filled', 'correct', 'wrong');
      }

      function placeWord(slotEl, wordEl) {
        if (slotEl.classList.contains('locked')) return;

        // Evict any word already in the slot
        if (slotEl.dataset.placed) returnToBank(slotEl);

        // Place word
        slotEl.textContent = wordEl.textContent;
        slotEl.dataset.placed = wordEl.textContent;
        slotEl.classList.add('filled');
        wordEl.style.display = 'none';
        wordEl.classList.remove('selected');
        selected = null;

        // Validate
        if (wordEl.textContent === slotEl.dataset.answer) {
          slotEl.classList.add('correct', 'locked');
          if (slotEls.every(s => s.classList.contains('locked'))) {
            setTimeout(onComplete, 400);
          }
        } else {
          onMistake();
          slotEl.classList.add('wrong');
          setTimeout(() => {
            wordEl.style.display = '';
            delete slotEl.dataset.placed;
            slotEl.textContent = '';
            slotEl.classList.remove('filled', 'wrong');
          }, 600);
        }
      }

      // Wire up word bank: click + drag
      for (const wordEl of wordEls) {
        wordEl.draggable = true;

        wordEl.addEventListener('click', () => {
          if (wordEl.style.display === 'none') return;
          if (selected === wordEl) { wordEl.classList.remove('selected'); selected = null; }
          else selectWord(wordEl);
        });

        wordEl.addEventListener('dragstart', (e) => {
          dragWord = wordEl;
          wordEl.classList.add('dragging');
          e.dataTransfer.effectAllowed = 'move';
        });
        wordEl.addEventListener('dragend', () => {
          wordEl.classList.remove('dragging');
          dragWord = null;
        });
      }

      // Wire up slots: click + drop target
      for (const slotEl of slotEls) {
        slotEl.addEventListener('click', () => {
          if (slotEl.classList.contains('locked')) return;
          if (selected) {
            placeWord(slotEl, selected);
          } else if (slotEl.dataset.placed) {
            returnToBank(slotEl);
          }
        });

        slotEl.addEventListener('dragover', (e) => {
          if (slotEl.classList.contains('locked')) return;
          e.preventDefault();
          slotEl.classList.add('drag-over');
        });
        slotEl.addEventListener('dragleave', () => slotEl.classList.remove('drag-over'));
        slotEl.addEventListener('drop', (e) => {
          e.preventDefault();
          slotEl.classList.remove('drag-over');
          if (dragWord) placeWord(slotEl, dragWord);
        });
      }

      return function solve() {
        for (const slotEl of slotEls) {
          if (slotEl.classList.contains('locked')) continue;
          const wordEl = wordEls.find(w => w.textContent === slotEl.dataset.answer && w.style.display !== 'none');
          if (wordEl) placeWord(slotEl, wordEl);
        }
      };
    }

    // ── Compass task ───────────────────────────────────────────────────────────
    function renderCompass(sub, container, onComplete, onMistake) {
      const shuffled = shuffle(sub.slots.map(s => s.answer));

      const posMap = { NW: [1,1], NE: [1,2], SW: [2,1], SE: [2,2] };

      const wrapEl = el('div', 'compass-wrap');
      wrapEl.appendChild(elText('span', 'compass-north', 'N'));
      const gridEl = el('div', 'compass-grid');
      const slotEls = sub.slots.map(slot => {
        const drop = el('div', 'slot-drop');
        drop.dataset.answer = slot.answer;
        const [row, col] = posMap[slot.label] || [1,1];
        drop.style.gridRow = row;
        drop.style.gridColumn = col;
        gridEl.appendChild(drop);
        return drop;
      });

      const bankEl = el('div', 'word-bank');
      const wordEls = shuffled.map(word => {
        const w = elText('button', 'bank-word', word);
        bankEl.appendChild(w);
        return w;
      });

      wrapEl.appendChild(gridEl);
      container.appendChild(wrapEl);
      container.appendChild(bankEl);

      requestAnimationFrame(() => {
        const maxW = Math.max(...wordEls.map(w => w.offsetWidth));
        slotEls.forEach(s => { s.style.minWidth = maxW + 'px'; });
      });

      let selected = null;
      let dragWord = null;

      function selectWord(wordEl) {
        if (selected) selected.classList.remove('selected');
        selected = wordEl;
        selected.classList.add('selected');
      }

      function returnToBank(slotEl) {
        const prevWord = slotEl.dataset.placed;
        const prevEl = wordEls.find(w => w.textContent === prevWord && w.style.display === 'none');
        if (prevEl) prevEl.style.display = '';
        delete slotEl.dataset.placed;
        slotEl.textContent = '';
        slotEl.classList.remove('filled', 'correct', 'wrong');
      }

      function placeWord(slotEl, wordEl) {
        if (slotEl.classList.contains('locked')) return;
        if (slotEl.dataset.placed) returnToBank(slotEl);

        slotEl.textContent = wordEl.textContent;
        slotEl.dataset.placed = wordEl.textContent;
        slotEl.classList.add('filled');
        wordEl.style.display = 'none';
        wordEl.classList.remove('selected');
        selected = null;

        if (wordEl.textContent === slotEl.dataset.answer) {
          slotEl.classList.add('correct', 'locked');
          if (slotEls.every(s => s.classList.contains('locked'))) {
            setTimeout(onComplete, 400);
          }
        } else {
          onMistake();
          slotEl.classList.add('wrong');
          setTimeout(() => {
            wordEl.style.display = '';
            delete slotEl.dataset.placed;
            slotEl.textContent = '';
            slotEl.classList.remove('filled', 'wrong');
          }, 600);
        }
      }

      for (const wordEl of wordEls) {
        wordEl.draggable = true;
        wordEl.addEventListener('click', () => {
          if (wordEl.style.display === 'none') return;
          if (selected === wordEl) { wordEl.classList.remove('selected'); selected = null; }
          else selectWord(wordEl);
        });
        wordEl.addEventListener('dragstart', (e) => {
          dragWord = wordEl;
          wordEl.classList.add('dragging');
          e.dataTransfer.effectAllowed = 'move';
        });
        wordEl.addEventListener('dragend', () => {
          wordEl.classList.remove('dragging');
          dragWord = null;
        });
      }

      for (const slotEl of slotEls) {
        slotEl.addEventListener('click', () => {
          if (slotEl.classList.contains('locked')) return;
          if (selected) { placeWord(slotEl, selected); }
          else if (slotEl.dataset.placed) { returnToBank(slotEl); }
        });
        slotEl.addEventListener('dragover', (e) => {
          if (slotEl.classList.contains('locked')) return;
          e.preventDefault();
          slotEl.classList.add('drag-over');
        });
        slotEl.addEventListener('dragleave', () => slotEl.classList.remove('drag-over'));
        slotEl.addEventListener('drop', (e) => {
          e.preventDefault();
          slotEl.classList.remove('drag-over');
          if (dragWord) placeWord(slotEl, dragWord);
        });
      }

      return function solve() {
        for (const slotEl of slotEls) {
          if (slotEl.classList.contains('locked')) continue;
          const wordEl = wordEls.find(w => w.textContent === slotEl.dataset.answer && w.style.display !== 'none');
          if (wordEl) placeWord(slotEl, wordEl);
        }
      };
    }

    // ── Categorize task ────────────────────────────────────────────────────────
    function renderCategorize(sub, container, onComplete, onMistake) {
      const allWords = shuffle(sub.groups.flatMap(g => g.answers));

      // Two-column layout with a header and blank slots per group
      const columnsEl = el('div', 'categorize-columns');
      const allSlotEls = [];

      sub.groups.forEach((group, groupIdx) => {
        const colEl = el('div', 'categorize-col');
        colEl.appendChild(elText('div', 'categorize-header', group.label));
        const slotsEl = el('div', 'categorize-slots');
        group.answers.forEach(() => {
          const drop = el('div', 'slot-drop');
          drop.dataset.groupIdx = groupIdx;
          slotsEl.appendChild(drop);
          allSlotEls.push(drop);
        });
        colEl.appendChild(slotsEl);
        columnsEl.appendChild(colEl);
      });

      const bankEl = el('div', 'word-bank');
      const wordEls = allWords.map(word => {
        const w = elText('button', 'bank-word', word);
        bankEl.appendChild(w);
        return w;
      });

      container.appendChild(columnsEl);
      container.appendChild(bankEl);

      let selected = null;
      let dragWord = null;

      function selectWord(wordEl) {
        if (selected) selected.classList.remove('selected');
        selected = wordEl;
        selected.classList.add('selected');
      }

      function returnToBank(slotEl) {
        const prevWord = slotEl.dataset.placed;
        const prevEl = wordEls.find(w => w.textContent === prevWord && w.style.display === 'none');
        if (prevEl) prevEl.style.display = '';
        delete slotEl.dataset.placed;
        slotEl.textContent = '';
        slotEl.classList.remove('filled', 'correct', 'wrong');
      }

      function placeWord(slotEl, wordEl) {
        if (slotEl.classList.contains('locked')) return;
        if (slotEl.dataset.placed) returnToBank(slotEl);

        slotEl.textContent = wordEl.textContent;
        slotEl.dataset.placed = wordEl.textContent;
        slotEl.classList.add('filled');
        wordEl.style.display = 'none';
        wordEl.classList.remove('selected');
        selected = null;

        // Validate: does this word belong to this group?
        const groupIdx = parseInt(slotEl.dataset.groupIdx);
        if (sub.groups[groupIdx].answers.includes(wordEl.textContent)) {
          slotEl.classList.add('correct', 'locked');
          if (allSlotEls.every(s => s.classList.contains('locked'))) {
            setTimeout(onComplete, 400);
          }
        } else {
          onMistake();
          slotEl.classList.add('wrong');
          setTimeout(() => {
            wordEl.style.display = '';
            delete slotEl.dataset.placed;
            slotEl.textContent = '';
            slotEl.classList.remove('filled', 'wrong');
          }, 600);
        }
      }

      for (const wordEl of wordEls) {
        wordEl.draggable = true;
        wordEl.addEventListener('click', () => {
          if (wordEl.style.display === 'none') return;
          if (selected === wordEl) { wordEl.classList.remove('selected'); selected = null; }
          else selectWord(wordEl);
        });
        wordEl.addEventListener('dragstart', (e) => {
          dragWord = wordEl;
          wordEl.classList.add('dragging');
          e.dataTransfer.effectAllowed = 'move';
        });
        wordEl.addEventListener('dragend', () => {
          wordEl.classList.remove('dragging');
          dragWord = null;
        });
      }

      for (const slotEl of allSlotEls) {
        slotEl.addEventListener('click', () => {
          if (slotEl.classList.contains('locked')) return;
          if (selected) { placeWord(slotEl, selected); }
          else if (slotEl.dataset.placed) { returnToBank(slotEl); }
        });
        slotEl.addEventListener('dragover', (e) => {
          if (slotEl.classList.contains('locked')) return;
          e.preventDefault();
          slotEl.classList.add('drag-over');
        });
        slotEl.addEventListener('dragleave', () => slotEl.classList.remove('drag-over'));
        slotEl.addEventListener('drop', (e) => {
          e.preventDefault();
          slotEl.classList.remove('drag-over');
          if (dragWord) placeWord(slotEl, dragWord);
        });
      }

      return function solve() {
        sub.groups.forEach((group, groupIdx) => {
          const emptySlots = allSlotEls.filter(s => parseInt(s.dataset.groupIdx) === groupIdx && !s.classList.contains('locked'));
          const remaining = group.answers.filter(a => wordEls.find(w => w.textContent === a && w.style.display !== 'none'));
          remaining.forEach((word, i) => {
            const wordEl = wordEls.find(w => w.textContent === word && w.style.display !== 'none');
            if (wordEl && emptySlots[i]) placeWord(emptySlots[i], wordEl);
          });
        });
      };
    }

    // ── Arrange task ───────────────────────────────────────────────────────────
    function renderArrange(sub, container, onComplete, onMistake, getPotential, refreshSkipLabel = () => {}) {
      const answerSet = new Set(sub.answer);

      function levenshteinAlign(user, answer) {
        const n = user.length, m = answer.length;
        const dp = Array.from({length: n + 1}, (_, i) =>
          Array.from({length: m + 1}, (_, j) => i === 0 ? j : j === 0 ? i : 0));
        for (let i = 1; i <= n; i++)
          for (let j = 1; j <= m; j++)
            dp[i][j] = user[i-1] === answer[j-1]
              ? dp[i-1][j-1]
              : 1 + Math.min(dp[i-1][j-1], dp[i-1][j], dp[i][j-1]);
        // Backtrack to label each user token
        const userOps = new Array(n).fill('wrong');
        let i = n, j = m;
        while (i > 0 || j > 0) {
          if (i > 0 && j > 0 && user[i-1] === answer[j-1]) {
            userOps[i-1] = 'match'; i--; j--;
          } else if (j > 0 && (i === 0 || dp[i][j-1] <= dp[i-1][j] && dp[i][j-1] <= dp[i-1][j-1])) {
            j--; // insert (missing from user) — no user token to label
          } else if (i > 0 && j > 0 && dp[i-1][j-1] <= dp[i-1][j]) {
            i--; j--; // substitute
          } else {
            i--; // delete (extra in user)
          }
        }
        // Classify non-matches: misplaced (word is in answer) vs wrong (distractor)
        const ops = userOps.map((op, k) =>
          op === 'match' ? 'match' : answerSet.has(user[k]) ? 'misplaced' : 'wrong'
        );
        // Truly missing: answer words not placed anywhere by the user
        const placedCount = {};
        for (const w of user) placedCount[w] = (placedCount[w] || 0) + 1;
        const trulyMissing = [];
        const answerCount = {};
        for (const w of answer) answerCount[w] = (answerCount[w] || 0) + 1;
        for (const [w, cnt] of Object.entries(answerCount)) {
          const placed = placedCount[w] || 0;
          for (let k = 0; k < Math.max(0, cnt - placed); k++) trulyMissing.push(w);
        }
        return { ops, distance: dp[n][m], trulyMissing };
      }

      const trayEl  = el('div', 'arrange-tray');
      const englishFeedbackEl = sub.showEnglishAtEnd && sub.english
        ? elText('div', 'english-text arrange-english-feedback', sub.english)
        : null;
      if (englishFeedbackEl) englishFeedbackEl.style.display = 'none';
      const bankEl  = el('div', 'word-bank arrange-bank');
      const checkBtn = el('button', 'arrange-check-btn');
      checkBtn.textContent = 'Check';
      const actionRow = el('div', 'arrange-action-row'); // holds retry + next after check

      const shuffledBank = shuffle([...sub.bank]);
      let trayWords = [];
      const bankBtns = shuffledBank.map(word => {
        const btn = elText('button', 'bank-word', word);
        bankEl.appendChild(btn);
        return btn;
      });
      const trayBtns = [];

      function refreshCheckBtn() {
        checkBtn.disabled = trayWords.length === 0;
      }

      function refreshTrayCapitalization() {
        trayBtns.forEach((tile, i) => {
          if (tile.classList.contains('revealed')) return;
          const original = tile.dataset.word || tile.textContent;
          const display = i === 0 ? original.charAt(0).toUpperCase() + original.slice(1) : original;
          tile.textContent = display;
          trayWords[i] = display;
        });
      }

      function addToTray(bankBtn) {
        const word = bankBtn.textContent;
        bankBtn.style.display = 'none';
        trayWords.push(word);
        const tileBtn = elText('button', 'bank-word arrange-tile', word);
        tileBtn.dataset.word = word;
        tileBtn.addEventListener('click', () => removeFromTray(tileBtn));
        trayEl.appendChild(tileBtn);
        trayBtns.push(tileBtn);
        refreshCheckBtn();
        refreshTrayCapitalization();
      }

      function removeFromTray(tileBtn) {
        if (tileBtn.classList.contains('correct')) return;
        const word = tileBtn.dataset.word || tileBtn.textContent;
        const idx = trayBtns.indexOf(tileBtn);
        trayBtns.splice(idx, 1);
        trayWords.splice(idx, 1);
        tileBtn.remove();
        const bankBtn = bankBtns.find(b => b.textContent === word && b.style.display === 'none');
        if (bankBtn) bankBtn.style.display = '';
        refreshCheckBtn();
        refreshTrayCapitalization();
      }

      function resetTray() {
        for (const tile of [...trayBtns]) tile.remove();
        trayBtns.length = 0;
        trayWords.length = 0;
        for (const btn of bankBtns) {
          btn.style.display = '';
          btn.classList.remove('arrange-should-use');
        }
        refreshCheckBtn();
      }

      for (const btn of bankBtns) {
        btn.addEventListener('click', () => { if (btn.style.display !== 'none') addToTray(btn); });
        btn.draggable = true;
        btn.addEventListener('dragstart', (e) => { e.dataTransfer.setData('text/plain', btn.textContent); btn.classList.add('dragging'); });
        btn.addEventListener('dragend', () => btn.classList.remove('dragging'));
      }
      trayEl.addEventListener('dragover',  (e) => { e.preventDefault(); trayEl.classList.add('drag-over'); });
      trayEl.addEventListener('dragleave', () => trayEl.classList.remove('drag-over'));
      trayEl.addEventListener('drop', (e) => {
        e.preventDefault();
        trayEl.classList.remove('drag-over');
        const word = e.dataTransfer.getData('text/plain');
        const bankBtn = bankBtns.find(b => b.textContent === word && b.style.display !== 'none');
        if (bankBtn) addToTray(bankBtn);
      });

      function doCheck() {
        const { ops, distance, trulyMissing } = levenshteinAlign(trayWords, sub.answer);

        if (englishFeedbackEl) englishFeedbackEl.style.display = '';
        for (let k = 0; k < distance; k++) onMistake();
        refreshSkipLabel();

        trayBtns.forEach((tile, k) => {
          tile.classList.add('locked');
          tile.classList.add(ops[k] === 'match' ? 'correct' : ops[k] === 'misplaced' ? 'misplaced' : 'wrong');
        });

        // Highlight bank words that should have been used but weren't
        for (const btn of bankBtns) btn.classList.remove('arrange-should-use');
        const highlightQueue = [...trulyMissing];
        for (const btn of bankBtns) {
          const idx = highlightQueue.indexOf(btn.textContent);
          if (idx !== -1 && btn.style.display !== 'none') {
            btn.classList.add('arrange-should-use');
            highlightQueue.splice(idx, 1);
          }
        }

        checkBtn.style.display = 'none';
        actionRow.innerHTML = '';

        if (distance === 0) {
          setTimeout(onComplete, 400);
        } else {
          const potential = getPotential();
          if (mode === 'challenging' || potential === 0) {
            const revealBtn = elText('button', 'arrange-check-btn arrange-retry-btn', 'Reveal');
            revealBtn.addEventListener('click', doReveal);
            actionRow.appendChild(revealBtn);
          } else {
            const retryBtn = elText('button', 'arrange-check-btn arrange-retry-btn', 'Try again');
            retryBtn.addEventListener('click', () => {
              resetTray();
              actionRow.innerHTML = '';
              checkBtn.style.display = '';
            });
            actionRow.appendChild(retryBtn);
          }
        }
      }

      function doReveal() {
        // Clear tray and fill with correct answer as revealed tiles
        for (const tile of [...trayBtns]) removeFromTray(tile);
        for (const word of sub.answer) {
          const bankBtn = bankBtns.find(b => b.textContent === word && b.style.display !== 'none');
          if (bankBtn) {
            bankBtn.style.display = 'none';
            trayWords.push(word);
            const tileBtn = elText('button', 'bank-word arrange-tile revealed locked', word);
            trayEl.appendChild(tileBtn);
            trayBtns.push(tileBtn);
          }
        }
        actionRow.innerHTML = '';
        const nextBtn2 = elText('button', 'arrange-check-btn arrange-next-btn', 'Next →');
        nextBtn2.addEventListener('click', () => { actionRow.innerHTML = ''; onComplete(); });
        actionRow.appendChild(nextBtn2);
      }

      checkBtn.addEventListener('click', doCheck);

      refreshCheckBtn();
      container.appendChild(trayEl);
      if (englishFeedbackEl) container.appendChild(englishFeedbackEl);
      container.appendChild(bankEl);
      container.appendChild(checkBtn);
      container.appendChild(actionRow);

      return function solve() {
        doReveal();
        onComplete();
      };
    }

    // ── Word order task ────────────────────────────────────────────────────────
    function renderWordOrder(sub, container, onComplete, onMistake) {
      // Support both single-clause {elements, target} and multi-clause {clauses:[...]}
      const clauses = sub.clauses || [{ elements: sub.elements, target: sub.target, prefix: sub.prefix, separator: sub.separator }];

      // Per-clause slot state — keys come from each clause's target object.
      // silentSlots: pre-filled with the target word, greyed stripe, locked.
      // blockedSlots: {slotKey: word} — greyed stripe placeholder that won't accept
      //   anything. A non-empty word is shown faint + struck through (a silent
      //   subordinator that is present but not said aloud); "" renders blank.
      //   (A legacy array of slot keys is also accepted; those render blank.)
      // givenSlots: pre-filled with the target word, shown as plain inline text, no tile.
      const clauseSlots = clauses.map(clause => {
        const slots = Object.fromEntries(Object.keys(clause.target).map(k => [k, null]));
        for (const key of (clause.silentSlots || [])) {
          const targetId = clause.target[key];
          if (targetId) slots[key] = { id: targetId, locked: true, silent: true };
        }
        const blocked = clause.blockedSlots || [];
        for (const key of (Array.isArray(blocked) ? blocked : Object.keys(blocked))) {
          slots[key] = { locked: true, silent: true, blocked: true };
        }
        for (const key of (clause.givenSlots || [])) {
          const targetId = clause.target[key];
          if (targetId) slots[key] = { id: targetId, locked: true, given: true };
        }
        return slots;
      });

      let selectedClause = null;
      let selectedId     = null;
      let dragClause     = null;
      let dragElemId     = null;
      let rejectElemId   = null;

      function findElem(ci, elemId) {
        return clauses[ci].elements.find(e => e.id === elemId);
      }

      function canAccept(ci, slotKey, elemId) {
        const elem = findElem(ci, elemId);
        if (!elem) return false;
        const clause = clauses[ci];
        const rule = clause.slotConfig?.[slotKey];
        if (rule === 'tensed')       return elem.tensed === true;
        if (rule === '!tensed')      return elem.tensed !== true;
        if (rule === 'wh')           return elem.category === 'wh';
        if (rule === 'subordinator') return elem.category === 'subordinator' || elem.category === 'wh';
        // Default V2: slot1 = topic (non-verb), slot2 = tensed verb
        if (slotKey === 'slot1') return elem.tensed !== true;
        if (slotKey === 'slot2') return elem.tensed === true;
        return false;
      }

      function slotTitle(clause, slotKey) {
        const rule = clause.slotConfig?.[slotKey];
        if (rule === 'tensed' || (rule === undefined && slotKey === 'slot2'))
          return 'Only conjugated verbs';
        if (rule === 'wh')           return 'Only wh-words';
        if (rule === 'subordinator') return 'Subordinator (wh-word or dass)';
        return 'Anything except a conjugated verb';
      }

      // Capitalize the first leading slot of clause[0] when there's no prefix
      function displayText(text, ci, slotKey) {
        const clause = clauses[ci];
        const slotKeys = Object.keys(clause.target);
        if (ci === 0 && slotKey === slotKeys[0]) {
          const prefix = clauses[0].prefix;
          const hasPrefix = prefix && (Array.isArray(prefix) ? prefix.length > 0 : true);
          if (!hasPrefix) return text.charAt(0).toUpperCase() + text.slice(1);
        }
        return text;
      }

      function checkComplete() {
        const allCorrect = clauses.every((clause, ci) => {
          const s = clauseSlots[ci];
          return Object.keys(clause.target).every(k => s[k]?.locked);
        });
        if (allCorrect) setTimeout(onComplete, 400);
      }

      function tryPlace(ci, slotKey, elemId) {
        const slots = clauseSlots[ci];
        if (slots[slotKey] !== null) return;
        selectedId = null; selectedClause = null;
        dragElemId = null; dragClause = null;
        if (!canAccept(ci, slotKey, elemId)) { rejectElemId = elemId; onMistake(); render(); return; }
        const correct = clauses[ci].target[slotKey] === elemId;
        slots[slotKey] = { id: elemId, locked: correct };
        if (!correct) onMistake();
        render();
        if (correct) checkComplete();
      }

      const surface              = el('div', 'wordorder-surface');
      const slotDropsByClause    = [];
      const rowsByClause         = [];
      const dynamicSuffixByClause = [];

      clauses.forEach((clause, ci) => {
        const row       = el('div', 'wordorder-main-row');
        const slotDrops = {};
        const slotKeys  = Object.keys(clause.target);

        function makeSlotDrop(slotKey) {
          const wrap = el('div', 'wordorder-slot-wrap');
          const drop = el('div', 'wordorder-slot-drop');
          drop.title = slotTitle(clause, slotKey);
          drop.addEventListener('click', () => {
            if (selectedId === null || selectedClause !== ci || clauseSlots[ci][slotKey] !== null) return;
            tryPlace(ci, slotKey, selectedId);
          });
          drop.addEventListener('dragover', (e) => {
            if (clauseSlots[ci][slotKey] !== null || dragClause !== ci) return;
            e.preventDefault();
            drop.classList.add('wordorder-drag-over');
          });
          drop.addEventListener('dragleave', () => drop.classList.remove('wordorder-drag-over'));
          drop.addEventListener('drop', (e) => {
            e.preventDefault();
            drop.classList.remove('wordorder-drag-over');
            if (dragElemId === null || dragClause !== ci || clauseSlots[ci][slotKey] !== null) return;
            tryPlace(ci, slotKey, dragElemId);
          });
          wrap.appendChild(drop);
          slotDrops[slotKey] = drop;
          return wrap;
        }

        // Prefix words: static tiles rendered before the slots
        const prefixWords = clause.prefix
          ? (Array.isArray(clause.prefix) ? clause.prefix : [clause.prefix])
          : [];
        prefixWords.forEach(pw => {
          row.appendChild(elText('span', 'wordorder-prefix-word', pw.text));
        });

        slotKeys.forEach(key => row.appendChild(makeSlotDrop(key)));

        // dynamicSuffix is the insertion anchor: loose tiles go before it
        const dynamicSuffix = el('span', 'wordorder-dynamic-suffix');
        row.appendChild(dynamicSuffix);

        if (clause.separator) {
          row.appendChild(elText('span', 'wordorder-separator', clause.separator));
        }

        surface.appendChild(row);
        slotDropsByClause.push(slotDrops);
        rowsByClause.push(row);
        dynamicSuffixByClause.push(dynamicSuffix);
      });

      container.appendChild(surface);

      function render() {
        clauses.forEach((clause, ci) => {
          const slots         = clauseSlots[ci];
          const slotDrops     = slotDropsByClause[ci];
          const row           = rowsByClause[ci];
          const dynamicSuffix = dynamicSuffixByClause[ci];

          Object.keys(clause.target).forEach(slotKey => {
            const drop = slotDrops[slotKey];
            drop.innerHTML = '';
            drop.classList.remove('wordorder-slot-given');
            const slotState = slots[slotKey];
            if (slotState !== null) {
              if (slotState.given) {
                drop.classList.add('wordorder-slot-given');
                const elem = findElem(ci, slotState.id);
                drop.appendChild(elText('span', 'wordorder-prefix-word', displayText(elem.text, ci, slotKey)));
              } else {
                const tile = el('button', 'wordorder-tile wordorder-tile-placed wordorder-tile-locked' +
                  (slotState.silent ? ' wordorder-tile-silent' : ''));
                tile.disabled = true;
                if (slotState.blocked) {
                  const bs = clauses[ci].blockedSlots;
                  const ghost = Array.isArray(bs) ? '' : bs?.[slotKey];
                  if (ghost) {
                    tile.appendChild(elText('span', 'wordorder-ghost-word', ghost));
                    tile.title = 'Silent — present, but not said aloud';
                  } else {
                    tile.appendChild(elText('span', '', ' '));
                  }
                } else {
                  const elem = findElem(ci, slotState.id);
                  tile.appendChild(elText('span', '', displayText(elem.text, ci, slotKey)));
                  if (!slotState.locked) {
                    tile.classList.replace('wordorder-tile-locked', 'wordorder-tile-wrong');
                    tile.disabled = false;
                    tile.appendChild(elText('span', 'wordorder-remove-icon', '×'));
                    tile.addEventListener('click', (e) => {
                      e.stopPropagation();
                      slots[slotKey] = null;
                      render();
                    });
                  }
                }
                drop.appendChild(tile);
              }
            }
          });

          // Separable verb prefix: appears after loose tiles when its verb is placed
          const placedSepElem = Object.values(slots).filter(Boolean)
            .map(s => findElem(ci, s.id)).find(e => e?.separablePrefix);
          dynamicSuffix.textContent = placedSepElem ? placedSepElem.separablePrefix : '';

          // Remove old loose tiles then re-insert before dynamicSuffix
          row.querySelectorAll('.wordorder-loose-tile').forEach(e => e.remove());
          const placed = new Set(Object.values(slots).filter(Boolean).map(s => s.id));
          clause.elements.forEach(elem => {
            if (placed.has(elem.id)) return;
            const isSelected = selectedClause === ci && selectedId === elem.id;
            const label = elem.separablePrefix ? elem.separablePrefix + elem.text : elem.text;
            const isRejecting = rejectElemId === elem.id;
            const tile = elText('button',
              'wordorder-tile wordorder-loose-tile' + (isSelected ? ' selected' : '') + (isRejecting ? ' wordorder-tile-reject' : ''), label);
            if (isRejecting) tile.addEventListener('animationend', () => { rejectElemId = null; }, { once: true });
            tile.draggable = true;
            tile.addEventListener('click', () => {
              if (selectedClause === ci && selectedId === elem.id) {
                selectedId = null; selectedClause = null;
              } else {
                selectedId = elem.id; selectedClause = ci;
              }
              render();
            });
            tile.addEventListener('dragstart', (e) => {
              dragElemId = elem.id; dragClause = ci;
              selectedId = null; selectedClause = null;
              e.dataTransfer.effectAllowed = 'move';
              setTimeout(() => tile.classList.add('dragging'), 0);
            });
            tile.addEventListener('dragend', () => {
              tile.classList.remove('dragging');
              dragElemId = null; dragClause = null;
              render();
            });
            row.insertBefore(tile, dynamicSuffix);
          });
        });
      }

      render();

      return function solve() {
        clauses.forEach((clause, ci) => {
          Object.keys(clause.target).forEach(slotKey => {
            clauseSlots[ci][slotKey] = { id: clause.target[slotKey], locked: true };
          });
        });
        render();
        setTimeout(onComplete, 400);
      };
    }

    // ── Helpers ────────────────────────────────────────────────────────────────
    function wrapEmojis(el) {
      const emojiRe = /\p{Extended_Pictographic}️?/gu;
      const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
      const textNodes = [];
      let node;
      while ((node = walker.nextNode())) textNodes.push(node);
      for (const textNode of textNodes) {
        const text = textNode.textContent;
        if (!emojiRe.test(text)) { emojiRe.lastIndex = 0; continue; }
        emojiRe.lastIndex = 0;
        const frag = document.createDocumentFragment();
        let last = 0;
        for (const m of text.matchAll(emojiRe)) {
          if (m.index > last) frag.appendChild(document.createTextNode(text.slice(last, m.index)));
          const span = document.createElement('span');
          span.className = 'emoji';
          span.textContent = m[0];
          frag.appendChild(span);
          last = m.index + m[0].length;
        }
        if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
        textNode.parentNode.replaceChild(frag, textNode);
      }
    }

    function shuffle(arr) {
      const a = [...arr];
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }
    function el(tag, cls) {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      return e;
    }
    function elText(tag, cls, text) {
      const e = el(tag, cls);
      e.textContent = text;
      return e;
    }

    // ── Build-a-word task ──────────────────────────────────────────────────────
    function renderBuildAWord(sub, container, onComplete, onMistake, refreshHintBtn = () => {}) {
      let selectedMorpheme = null;
      let lockedCount = 0;
      const totalBlanks = sub.words.reduce(
        (sum, w) => sum + w.parts.filter(p => p.blank !== undefined).length, 0);

      const wrapper = el('div', 'baw-wrapper');
      const grid = el('div', 'baw-grid');
      const allSlots = [];

      const isSep = g => g.every(p => p.text !== undefined && (/^[\s,;.!?]+$/.test(p.text) || p.sep));

      sub.words.forEach(word => {
        const row = el('div', 'baw-word-row');
        row.appendChild(elText('div', 'baw-definition', word.definition));
        const partsCol = el('div', 'baw-parts');

        // Group parts: join:true parts attach to the previous group
        const groups = [];
        word.parts.forEach(part => {
          if (!part.join || groups.length === 0) groups.push([part]);
          else groups[groups.length - 1].push(part);
        });

        // Split groups into semantic words at separator boundaries;
        // consecutive non-separator groups accumulate into the same semantic word
        const swUnits = [];
        let pendingSeps = [];
        let currentUnit = null;
        groups.forEach(group => {
          if (isSep(group)) {
            pendingSeps.push(group);
          } else {
            if (currentUnit === null || pendingSeps.length > 0) {
              currentUnit = { groups: [], sepsBefore: pendingSeps };
              pendingSeps = [];
              swUnits.push(currentUnit);
            }
            currentUnit.groups.push(group);
          }
        });

        swUnits.forEach((unit, ui) => {
          // Render preceding separators
          unit.sepsBefore.forEach(sg => {
            const sepEl = el('span', 'baw-word-sep');
            sg.forEach(p => sepEl.appendChild(elText('span', 'baw-part-text', p.text)));
            partsCol.appendChild(sepEl);
          });

          // Dot between semantic words (when no separator in between)
          if (ui > 0 && unit.sepsBefore.length === 0) {
            partsCol.appendChild(elText('span', 'baw-separator', '·'));
          }

          const swEl = el('span', 'baw-semantic-word');
          const swBlanks = [];

          unit.groups.forEach((group, gi) => {
            if (gi > 0) swEl.appendChild(elText('span', 'baw-separator', '·'));
            const groupEl = el('span', 'baw-word-group');
            group.forEach((part, pi) => {
              if (pi > 0) groupEl.appendChild(elText('span', 'baw-separator', '·'));
              if (part.text !== undefined) {
                groupEl.appendChild(elText('span', 'baw-part-text', part.text));
              } else {
                const slot = el('button', 'baw-slot');
                slot.dataset.answer = part.blank.toLowerCase();
                const slotInfo = { el: slot, answer: part.blank, match: part.match || part.blank, locked: false, swBlanks, swEl };
                swBlanks.push(slotInfo);
                allSlots.push(slotInfo);
                slot.addEventListener('click', () => {
                  if (slotInfo.locked || !selectedMorpheme) return;
                  attemptPlace(slotInfo, selectedMorpheme);
                });
                slot.addEventListener('dragover', e => {
                  e.preventDefault();
                  slot.classList.add('baw-drag-over');
                });
                slot.addEventListener('dragleave', () => slot.classList.remove('baw-drag-over'));
                slot.addEventListener('drop', e => {
                  e.preventDefault();
                  slot.classList.remove('baw-drag-over');
                  const morph = e.dataTransfer.getData('text/plain');
                  if (morph) attemptPlace(slotInfo, morph);
                });
                groupEl.appendChild(slot);
              }
            });
            swEl.appendChild(groupEl);
          });
          partsCol.appendChild(swEl);
        });

        pendingSeps.forEach(sg => {
          const sepEl = el('span', 'baw-word-sep');
          sg.forEach(p => sepEl.appendChild(elText('span', 'baw-part-text', p.text)));
          partsCol.appendChild(sepEl);
        });

        row.appendChild(partsCol);
        grid.appendChild(row);
      });

      wrapper.appendChild(grid);

      const bank = el('div', 'baw-bank word-bank');
      const shuffledBank = shuffle([...sub.bank]);
      shuffledBank.forEach(morph => {
        const tile = elText('button', 'baw-bank-tile', morph);
        tile.draggable = true;
        tile.addEventListener('click', () => {
          selectedMorpheme = (selectedMorpheme === morph) ? null : morph;
          bank.querySelectorAll('.baw-bank-tile').forEach(t =>
            t.classList.toggle('baw-bank-tile-selected', t.textContent === selectedMorpheme));
        });
        tile.addEventListener('dragstart', e => {
          e.dataTransfer.setData('text/plain', morph);
        });
        bank.appendChild(tile);
      });
      wrapper.appendChild(bank);
      container.appendChild(wrapper);

      function deselect() {
        selectedMorpheme = null;
        bank.querySelectorAll('.baw-bank-tile').forEach(t => t.classList.remove('baw-bank-tile-selected'));
      }

      function attemptPlace(slotInfo, morph) {
        if (slotInfo.locked) return;
        deselect();
        if (morph.toLowerCase() === slotInfo.match.toLowerCase()) {
          slotInfo.locked = true;
          slotInfo.el.textContent = slotInfo.answer;
          slotInfo.el.classList.add('baw-slot-correct');
          slotInfo.el.disabled = true;
          lockedCount++;
          refreshHintBtn();
          if (slotInfo.swBlanks.every(s => s.locked)) {
            slotInfo.swEl.classList.add('baw-word-complete');
          }
          if (lockedCount === totalBlanks) onComplete();
        } else {
          onMistake();
          slotInfo.el.textContent = morph;
          slotInfo.el.classList.add('baw-slot-wrong');
          setTimeout(() => {
            slotInfo.el.textContent = '';
            slotInfo.el.classList.remove('baw-slot-wrong');
          }, 600);
        }
      }

      return () => {
        allSlots.forEach(s => {
          if (!s.locked) {
            s.locked = true;
            s.el.textContent = s.answer;
            s.el.classList.add('baw-slot-correct');
            s.el.disabled = true;
          }
        });
        allSlots.forEach(s => {
          if (s.swBlanks.every(b => b.locked)) {
            s.swEl.classList.add('baw-word-complete');
          }
        });
        onComplete();
      };
    }

    // ── Match task ─────────────────────────────────────────────────────────────
    function renderMatch(sub, container, onAddPoints, onDone) {
      const isMobile   = window.innerWidth < 520;
      const INITIAL    = isMobile ? 6 : 7;
      const BATCH_SIZE = 2;
      const REFILL_AT  = isMobile ? 4 : 5;

      // Shuffle pairs, assign stable ids
      const allPairs = sub.pairs.map((p, i) => ({ ...p, id: i }));
      const queue = [...allPairs].reverse(); // reversed so pop() yields pairs in original order
      let tiles = []; // { el, pairId, matched }
      let zTop = 1;
      let done = false;

      // Timer
      const timeLimit = sub.timeLimit;
      let timeLeft = timeLimit;
      let timerInterval = null;

      function fmtTime(s) {
        return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
      }

      let timerEl = null;
      if (mode !== 'casual' && timeLimit) {
        timerEl = elText('div', 'match-timer', fmtTime(timeLeft));
      }

      // Draggable area (added to DOM when game starts)
      const area = el('div', 'match-area');

      function spawnTile(word, pairId, lang) {
        const tile = elText('button', 'match-tile', word);
        if (lang === 'en') tile.classList.add('match-tile-en');
        tile.style.left = '0px';
        tile.style.top  = '0px';
        tile.style.opacity = '0';
        const entry = { el: tile, pairId, matched: false, positioned: false };
        tiles.push(entry);
        makeDraggable(tile, entry);
        area.appendChild(tile);
        return entry;
      }

      function placeEntry(entry) {
        const pad = 10;
        const aW  = area.offsetWidth;
        const aH  = area.offsetHeight;
        const tw  = entry.el.offsetWidth  || 80;
        const th  = entry.el.offsetHeight || 36;
        const maxX = Math.max(pad, aW - tw - pad);
        const maxY = Math.max(pad, aH - th - pad);

        let bestX = pad + Math.random() * (maxX - pad);
        let bestY = pad + Math.random() * (maxY - pad);
        let bestOverlap = Infinity;

        for (let attempt = 0; attempt < 5; attempt++) {
          const x = pad + Math.random() * (maxX - pad);
          const y = pad + Math.random() * (maxY - pad);
          let overlap = 0;
          for (const other of tiles) {
            if (other === entry || other.matched || !other.positioned) continue;
            const ox = parseFloat(other.el.style.left);
            const oy = parseFloat(other.el.style.top);
            const ow = other.el.offsetWidth  || 80;
            const oh = other.el.offsetHeight || 36;
            const dx = Math.min(x + tw + 8, ox + ow + 8) - Math.max(x, ox);
            const dy = Math.min(y + th + 8, oy + oh + 8) - Math.max(y, oy);
            if (dx > 0 && dy > 0) overlap += dx * dy;
          }
          if (overlap < bestOverlap) { bestOverlap = overlap; bestX = x; bestY = y; }
          if (overlap === 0) break;
        }
        entry.el.style.left = bestX + 'px';
        entry.el.style.top  = bestY + 'px';
        entry.positioned = true;
        entry.el.style.opacity = '';
      }

      function addBatch(count = BATCH_SIZE) {
        const newEntries = [];
        for (let i = 0; i < count && queue.length > 0; i++) {
          const pair = queue.pop();
          newEntries.push(spawnTile(pair.german, pair.id, 'de'));
          newEntries.push(spawnTile(pair.english, pair.id, 'en'));
        }
        requestAnimationFrame(() => newEntries.forEach(placeEntry));
      }

      function makeDraggable(tile, entry) {
        let startX, startY, startLeft, startTop, moved;

        function dragStart(cx, cy) {
          if (entry.matched) return;
          startX = cx; startY = cy;
          startLeft = parseFloat(tile.style.left);
          startTop  = parseFloat(tile.style.top);
          tile.style.zIndex = ++zTop;
          moved = false;
        }

        function dragMove(cx, cy) {
          tile.style.left = (startLeft + cx - startX) + 'px';
          tile.style.top  = (startTop  + cy - startY) + 'px';
          moved = true;
        }

        function dragEnd() {
          if (!moved || entry.matched) return;
          const tRect = tile.getBoundingClientRect();
          for (const other of tiles) {
            if (other === entry || other.matched) continue;
            const oRect = other.el.getBoundingClientRect();
            const overlaps = !(tRect.right < oRect.left || tRect.left > oRect.right ||
                                tRect.bottom < oRect.top || tRect.top > oRect.bottom);
            if (overlaps && other.pairId === entry.pairId) {
              dismissPair(entry, other);
              return;
            }
          }
        }

        tile.addEventListener('mousedown', e => {
          e.preventDefault();
          dragStart(e.clientX, e.clientY);
          const onMove = e => dragMove(e.clientX, e.clientY);
          const onUp   = () => { document.removeEventListener('mousemove', onMove); document.removeEventListener('mouseup', onUp); dragEnd(); };
          document.addEventListener('mousemove', onMove);
          document.addEventListener('mouseup', onUp);
        });

        tile.addEventListener('touchstart', e => {
          dragStart(e.touches[0].clientX, e.touches[0].clientY);
        }, { passive: true });
        tile.addEventListener('touchmove', e => {
          e.preventDefault();
          dragMove(e.touches[0].clientX, e.touches[0].clientY);
        }, { passive: false });
        tile.addEventListener('touchend', () => dragEnd());
      }

      function dismissPair(a, b) {
        a.matched = b.matched = true;
        a.el.classList.add('matched');
        b.el.classList.add('matched');
        onAddPoints(sub.points ?? 5);
        setTimeout(() => {
          a.el.remove(); b.el.remove();
          tiles = tiles.filter(t => t !== a && t !== b);
          const remaining = new Set(tiles.filter(t => !t.matched).map(t => t.pairId)).size;
          if (queue.length > 0 && remaining <= REFILL_AT) addBatch(BATCH_SIZE);
          if (tiles.length === 0 && queue.length === 0) endMatch();
        }, 350);
      }

      function endMatch() {
        if (done) return;
        done = true;
        if (timerInterval) clearInterval(timerInterval);
        // Fade out any remaining tiles
        tiles.forEach(t => { if (!t.matched) t.el.classList.add('matched'); });
        setTimeout(onDone, 400);
      }

      container.closest('.sub-level-card')?.classList.add('match-playing');
      container.appendChild(area);
      if (timerEl) container.insertBefore(timerEl, area);
      if (mode !== 'casual' && timeLimit) {
        timerInterval = setInterval(() => {
          timeLeft--;
          timerEl.textContent = fmtTime(timeLeft);
          if (timeLeft <= 10) timerEl.classList.add('warning');
          if (timeLeft <= 0) endMatch();
        }, 1000);
      }
      addBatch(INITIAL);
    }

    // ── Boot ───────────────────────────────────────────────────────────────────
    if (new URLSearchParams(window.location.search).has('review') && isAnyDone()) {
      score = anyDoneScore();
      showLevelComplete(true);
    } else {
      renderSubLevel(currentIdx);
    }
  </script>

  <script>
    import rough from 'roughjs';
    document.querySelectorAll('.crayon-line').forEach(svg => {
      const rc = rough.svg(svg);
      svg.appendChild(rc.line(1, 6, 99, 6, { stroke: '#b91c1c', strokeWidth: 2, roughness: 2.5, seed: 12 }));
    });
  </script>
</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    min-height: 100%;
    background: #f0efeb;
    font-family: 'Jost', sans-serif;
