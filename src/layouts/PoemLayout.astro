---
interface Props {
  title?: string;
  backHref?: string;
  backLabel?: string;
}

const { title = "Michelle Fullwood", backHref, backLabel = "Back" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <meta name="description" content="Personal website for Michelle Fullwood, NLP scientist and linguistic tinkerer." />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IM+Fell+English:ital@0;1&family=Jost:ital,wght@0,200;0,400;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    {backHref && (
      <a class="back-link" href={backHref}>&#8592; {backLabel}</a>
    )}
    <slot />
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    min-height: 100%;
    background-color: #0a0a0f;
    color: #c8c0b4;
  }

  body {
    font-family: 'Jost', sans-serif;
    font-size: 1rem;
  }

  .back-link {
    position: fixed;
    top: 1rem;
    left: 1rem;
    font-family: 'Jost', sans-serif;
    font-size: 0.78rem;
    font-weight: 200;
    letter-spacing: 0.05em;
    color: #4a4642;
    text-decoration: none;
    z-index: 20;
    padding: 0.3rem 0.5rem;
    transition: color 0.15s;
  }

  .back-link:hover {
    color: #9a9288;
  }
</style>
